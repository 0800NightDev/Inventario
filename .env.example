# Variables de entorno requeridas para el funcionamiento de Inventario Radiografía
# Copia este archivo como .env y completa los valores

# Supabase - Obtén estos valores desde https://supabase.com/dashboard/project/[tu-proyecto]/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT - Genera un secreto seguro (mínimo 32 caracteres)
JWT_SECRET=tu-secreto-jwt-super-seguro-cambiar-en-produccion
